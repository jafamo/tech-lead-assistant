# =============================================================================
# Tech Lead Assistant (TLA) — Configuración
# =============================================================================
# Copia a `.env` y rellena. NUNCA commitear `.env`.
# Cambios requieren reiniciar la app.
# =============================================================================


# === Server (NiceGUI) ========================================================
TLA_HOST=127.0.0.1
TLA_PORT=8080


# === Paths — datos ============================================================
# Directorio raíz de datos. Puede ser local o unidad de red montada (SMB/NFS).
# Ejemplos:
#   Local Linux:    /home/usuario/Documents/TLA
#   Local Windows:  C:\Users\usuario\Documents\TLA
#   Red Linux:      /mnt/nas/TLA
#   Red Windows:    Z:\TLA
TLA_DATA_ROOT=

# Fichero SQLite de índice. SIEMPRE local — NO poner en red.
# Vacío = default per-OS:
#   Linux:    ~/.local/share/tla/tla.db
#   Windows:  %APPDATA%\TLA\tla.db
TLA_DB_PATH=


# === Paths — reports import (staging) =========================================
# Directorio donde el usuario deposita reports preparados externamente (con IA).
# Estructura esperada: {dir}/{slug-persona}/content.json
# Vacío = {TLA_DATA_ROOT}/_import/
TLA_REPORTS_IMPORT_DIR=


# === Paths — estadísticas =====================================================
# Directorio donde se depositan ficheros de estadísticas generados por IA.
# La app los visualiza, no los genera.
# Vacío = {TLA_DATA_ROOT}/_stats/
TLA_STATS_DIR=

# Histórico de estadísticas (versiones anteriores).
# Vacío = {TLA_STATS_DIR}/history/
TLA_STATS_HISTORY_DIR=


# === Paths — logs =============================================================
# Vacío = default per-OS:
#   Linux:    ~/.local/share/tla/logs/
#   Windows:  %APPDATA%\TLA\logs\
TLA_LOG_DIR=


# === LLM (todo opcional) =====================================================
# Si no usas LLM, deja TLA_LLM_PROVIDER=none.
# Valores: anthropic | openai | ollama | none
TLA_LLM_PROVIDER=none

# Modelo por defecto (ignorado si provider=none).
# Ejemplos: claude-sonnet-4-7, gpt-5, llama3.1:70b
TLA_LLM_MODEL=

# API keys (solo se usa la del provider activo).
TLA_ANTHROPIC_API_KEY=
TLA_OPENAI_API_KEY=

# Host de Ollama.
TLA_OLLAMA_HOST=http://localhost:11434


# === Sesión ===================================================================
TLA_SESSION_TIMEOUT_MIN=30
TLA_LOG_LEVEL=INFO
TLA_LOCALE=es


# === Rescan y red =============================================================
TLA_RESCAN_ON_STARTUP=true
TLA_NETWORK_TIMEOUT_SEC=10
TLA_NETWORK_RETRY_COUNT=2


# === UI =======================================================================
# Tema visual: auto | light | dark
TLA_THEME=auto
